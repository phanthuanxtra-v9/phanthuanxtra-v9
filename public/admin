<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>PHAN THUẦN XTRA — Admin</title></head><body><main><h1>PHAN THUẦN XTRA</h1><p>Đăng nhập Admin để quản lý và đăng xe lên website.</p><label for="password">MẬT KHẨU QUẢN TRỊ</label><br><input id="password" type="password" autocomplete="current-password"><button id="loginBtn" type="button">Đăng nhập</button><p id="msg"></p></main><script>const $=id=>document.getElementById(id);async function login(){const password=$("password").value.trim();if(!password){$("msg").textContent="Vui lòng nhập mật khẩu";return}$("loginBtn").disabled=true;try{const r=await fetch("/api/admin/login",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({password})});const d=await r.json().catch(()=>({}));if(!r.ok||!d.ok)throw Error(d.error||"Đăng nhập thất bại");sessionStorage.setItem("ptx_admin_token",d.token);location.replace("/admin-control.html?v="+Date.now())}catch(e){$("msg").textContent=e.message;$("loginBtn").disabled=false}}$("loginBtn").onclick=login;$("password").onkeydown=e=>{if(e.key==="Enter")login()}</script></body></html>