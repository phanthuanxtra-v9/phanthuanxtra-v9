<resources>
    <style name="XtraButton" parent="@android:style/Widget.Material.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:minWidth">120dp</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textColor">#F4F5F2</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:background">@drawable/xtra_button</item>
    </style>

    <style name="XtraEditText" parent="@android:style/Widget.Material.EditText">
        <item name="android:minHeight">52dp</item>
        <item name="android:textColor">#F4F5F2</item>
        <item name="android:textColorHint">#A9AFB5</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:background">@drawable/xtra_input</item>
    </style>

    <style name="XtraTextView" parent="@android:style/Widget.Material.TextView">
        <item name="android:textColor">#F4F5F2</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">#050505</item>
        <item name="android:colorAccent">#D4AF37</item>
        <item name="android:navigationBarColor">#050505</item>
        <item name="android:statusBarColor">#050505</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:buttonStyle">@style/XtraButton</item>
        <item name="android:editTextStyle">@style/XtraEditText</item>
        <item name="android:textViewStyle">@style/XtraTextView</item>
    </style>
</resources>
